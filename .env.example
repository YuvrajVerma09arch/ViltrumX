# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=viltrumx_dev
NEO4J_PASSWORD=viltrumx_dev
DJANGO_SECRET_KEY=change-me
DEBUG=true

# LLM explanation layer (never used for detection — see CLAUDE.md §6)
# Default provider: Groq free tier
GROQ_API_KEY=
# Sovereign mode: local Ollama (e.g. `ollama pull llama3.1:8b`)
# OLLAMA_BASE_URL=http://localhost:11434

# Connectors
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Orchestrator -> Django service auth (ARCH §6). Generate per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCHESTRATOR_SERVICE_TOKEN=
