# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=viltrumx_dev
NEO4J_PASSWORD=viltrumx_dev
DJANGO_SECRET_KEY=change-me
DEBUG=true

# LLM explanation layer (never used for detection — see CLAUDE.md §6)
# Default provider: Groq free tier
GROQ_API_KEY=
# Sovereign mode: local Ollama (e.g. `ollama pull llama3.1:8b`)
# OLLAMA_BASE_URL=http://localhost:11434

# Connectors
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Orchestrator -> Django service auth (ARCH §6). Generate per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCHESTRATOR_SERVICE_TOKEN=

# ── Django / deployment ──────────────────────────────────────────────────────
# dev | staging | prod — selects backend/viltrumx/settings/<name>.py
DJANGO_SETTINGS_MODULE=viltrumx.settings.dev
# Comma-separated hostnames Django will answer for (no scheme, no spaces).
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST with CSRF (scheme required).
CSRF_TRUSTED_ORIGINS=

# ── Transactional email (signup / owner-login verification codes) ────────────
# Default console backend just prints codes; set SMTP values for real delivery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ViltrumX <no-reply@yourdomain>

# Public URL of the SPA (OAuth redirects / links in emails).
FRONTEND_URL=https://app.yourdomain
# Base path the built frontend calls the API on (behind nginx).
VITE_API_URL=/api/v1

# Set to 1 on the backend service so entrypoint.sh runs migrations on boot.
RUN_MIGRATIONS=0

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
# Test keys work with zero KYC; LIVE keys require account activation (see
# docs/P4-COMPLETION.md). Use rzp_test_* in dev, rzp_live_* in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret is SEPARATE from the key secret and per-mode (test/live).
# Register the webhook URL https://<host>/webhooks/razorpay in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# GST invoicing — your seller identity. Seller state decides CGST+SGST vs IGST.
GST_SELLER_GSTIN=
GST_SELLER_STATE=KA

# ── Startup verification ─────────────────────────────────────────────────────
# Require a company-domain email at signup (blocks gmail creating an org).
REQUIRE_BUSINESS_EMAIL=1
# DNS TXT ownership check on/off (disable only for offline test envs).
VERIFICATION_DNS_ENABLED=1
# Optional GSTIN vendor lookup (Surepass/Karza). Empty => checksum-only.
GSTIN_API_KEY=
GSTIN_API_URL=

# ── Orchestrator publish (P1 spine) ──────────────────────────────────────────
ORCHESTRATOR_ENABLED=1
ORCHESTRATOR_STREAM=viltrumx:events
TENANT_HOME_COUNTRY=IN
